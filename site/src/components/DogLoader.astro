---
/* A cartoon dog, seen from above, chasing its own tail. Pure SVG + CSS. */
interface Props {
  label?: string;
  size?: number;
}
const { label = 'Loading', size = 44 } = Astro.props;
---

<span class="dog" role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'} style={`--dog-size:${size}px`}>
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="25" fill="none" stroke="currentColor" stroke-opacity="0.16" stroke-width="1.4" stroke-dasharray="1.5 5" stroke-linecap="round"></circle>
    <g class="dog__spin">
      <!-- tail: outline, fill, cream tip -->
      <g class="dog__tail">
        <path d="M43.5 74.1 C52 82 64 80 69 70" fill="none" stroke="var(--dog-line)" stroke-width="8" stroke-linecap="round"></path>
        <path d="M43.5 74.1 C52 82 64 80 69 70" fill="none" stroke="var(--dog-body)" stroke-width="5" stroke-linecap="round"></path>
        <circle cx="69" cy="70" r="2.6" fill="var(--dog-cream)"></circle>
      </g>
      <!-- paws, drawn first so only the tips peek out -->
      <g fill="var(--dog-dark)" stroke="var(--dog-line)" stroke-width="1.3">
        <circle cx="66.5" cy="21" r="3.7"></circle>
        <circle cx="58.5" cy="35.3" r="3.7"></circle>
        <circle cx="28.4" cy="75.8" r="3.7"></circle>
        <circle cx="39" cy="62.7" r="3.7"></circle>
      </g>
      <!-- body -->
      <path d="M43.5 74.1 A25 25 0 1 1 72.7 39.4" fill="none" stroke="var(--dog-line)" stroke-width="18" stroke-linecap="round"></path>
      <path d="M43.5 74.1 A25 25 0 1 1 72.7 39.4" fill="none" stroke="var(--dog-body)" stroke-width="15" stroke-linecap="round"></path>
      <path d="M25.4 54.3 A25 25 0 0 1 29.5 35.7" fill="none" stroke="var(--dog-dark)" stroke-width="9" stroke-linecap="round" opacity="0.85"></path>
      <!-- collar -->
      <path d="M63.4 39.5 L76 29.7" stroke="var(--signal)" stroke-width="3.4" stroke-linecap="round"></path>
      <!-- ears -->
      <g fill="var(--dog-dark)" stroke="var(--dog-line)" stroke-width="1.3">
        <ellipse cx="82.3" cy="40.4" rx="6.5" ry="3.8" transform="rotate(65 82.3 40.4)"></ellipse>
        <ellipse cx="68" cy="49" rx="6.5" ry="3.8" transform="rotate(65 68 49)"></ellipse>
      </g>
      <!-- head -->
      <circle cx="75.7" cy="45.7" r="10.5" fill="var(--dog-body)" stroke="var(--dog-line)" stroke-width="1.5"></circle>
      <ellipse cx="79.7" cy="54.3" rx="6" ry="4.6" transform="rotate(65 79.7 54.3)" fill="var(--dog-cream)" stroke="var(--dog-line)" stroke-width="1.3"></ellipse>
      <circle cx="81.8" cy="58.8" r="2.2" fill="var(--dog-line)"></circle>
      <circle cx="81.1" cy="46.5" r="1.8" fill="var(--dog-line)"></circle>
      <circle cx="72.9" cy="50.3" r="1.8" fill="var(--dog-line)"></circle>
      <circle cx="81.5" cy="46" r="0.6" fill="#fff"></circle>
      <circle cx="73.3" cy="49.8" r="0.6" fill="#fff"></circle>
    </g>
  </svg>
</span>
