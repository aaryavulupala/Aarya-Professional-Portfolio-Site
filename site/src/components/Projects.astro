---
import { Image } from 'astro:assets';
import { projects } from '../data/content';
import Section from './Section.astro';
import TechChips from './TechChips.astro';
import DogLoader from './DogLoader.astro';
---

<Section id="work" num="01" label="Selected work">
  <p class="section__intro">Three things I built, and how they actually work.</p>

  <div class="projects">
    {
      projects.map((p, i) => (
        <article class="project" id={p.slug} aria-labelledby={`${p.slug}-t`}>
          <figure class="project__media">
            <div class:list={['frame', { 'frame--art': p.art }]}>
              <span class="frame__wait" aria-hidden="true"><DogLoader label="" size={40} /></span>
              <Image src={p.image} alt={p.imageAlt} widths={[640, 960, 1280]} sizes="(min-width: 900px) 46vw, 92vw" quality={78} loading={i === 0 ? 'eager' : 'lazy'} data-fallback />
            </div>
            <figcaption class="mono muted">{p.imageCaption}</figcaption>
          </figure>

          <div class="project__body">
            <p class="mono muted">{p.kind}</p>
            <h3 id={`${p.slug}-t`}>{p.title}</h3>
            <p class="project__summary">{p.summary}</p>
            {p.status && <p class="mono project__status"><span aria-hidden="true">●</span> {p.status}</p>}

            <dl class="stats">
              {p.stats.map((s) => (
                <div>
                  <dt class="muted">{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>

            <h4 class="mono eyebrow">What I built</h4>
            <ul class="bullets">{p.built.map((b) => <li>{b}</li>)}</ul>

            <TechChips items={p.tech} label={`${p.title} technologies`} />

            <p class="project__links mono">
              {p.links.map((l) => <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
              {p.codeNote && <span class="muted">{p.codeNote}</span>}
            </p>
          </div>

          <div class="project__flow">
            <h4 class="mono eyebrow">How it fits together</h4>
            <ol class="flow">
              {p.flow.map((s, n) => (
                <li>
                  <span class="flow__n mono" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
                  <strong>{s.title}</strong>
                  <span class="muted">{s.detail}</span>
                </li>
              ))}
            </ol>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .projects {
    display: grid;
    gap: var(--space-9);
  }
  .project {
    display: grid;
    gap: var(--space-6);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    transition: border-color 0.25s, transform 0.3s var(--ease);
  }
  .frame--art {
    aspect-ratio: 1 / 1;
    background: #000;
  }
  .frame__wait {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .frame :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    background: var(--paper-2);
    transition: transform 0.6s var(--ease);
  }
  .frame--art :global(img) {
    object-fit: contain;
    background: #000;
  }
  .project:hover .frame {
    border-color: var(--signal);
    transform: translateY(-3px);
  }
  .project:hover .frame :global(img) {
    transform: scale(1.03);
  }
  figcaption {
    margin-top: var(--space-2);
  }
  h3 {
    margin: var(--space-1) 0 var(--space-4);
    font-size: var(--step-3);
  }
  .project__summary {
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }
  .project__status {
    color: var(--ink-muted);
    margin-bottom: var(--space-5);
  }
  .project__status span {
    color: var(--signal);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    padding-block: var(--space-4);
    margin-bottom: var(--space-5);
    border-block: 1px solid var(--rule);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end; /* value sits on top even when the label wraps */
    min-width: 7.5rem;
  }
  .stats dd {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stats dt {
    font-size: 0.85rem;
    line-height: 1.3;
    max-width: 16ch;
    margin-top: var(--space-1);
  }
  .eyebrow {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin: 0 0 var(--space-3);
  }
  .bullets {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    max-width: 62ch;
  }
  .bullets li {
    position: relative;
    padding-left: var(--space-5);
  }
  .bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--signal);
    font-family: var(--font-mono);
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
  }

  .project__flow {
    padding-top: var(--space-5);
    border-top: 1px dashed var(--rule);
  }
  .flow {
    display: grid;
    gap: var(--space-4);
    counter-reset: none;
  }
  .flow li {
    display: grid;
    gap: 2px;
    padding-left: var(--space-4);
    border-left: 2px solid var(--rule);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .flow__n {
    color: var(--signal);
  }

  @media (min-width: 900px) {
    .project {
      grid-template-columns: 6fr 5fr;
      gap: var(--space-7) var(--space-8);
      align-items: start;
    }
    .project:nth-child(even) {
      grid-template-columns: 5fr 6fr;
    }
    /* explicit placement: the media column alternates sides */
    .project__media {
      grid-column: 1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
    .project__body {
      grid-column: 2;
      grid-row: 1;
    }
    .project:nth-child(even) .project__media {
      grid-column: 2;
    }
    .project:nth-child(even) .project__body {
      grid-column: 1;
    }
    .project__flow {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .flow {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--space-5);
    }
    .flow li {
      padding: var(--space-3) 0 0;
      border-left: 0;
      border-top: 2px solid var(--rule);
      transition: border-color 0.2s;
    }
    .flow li:hover {
      border-color: var(--signal);
    }
  }
</style>
