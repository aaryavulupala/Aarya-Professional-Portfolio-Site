---
import { person, projects, sections } from '../data/content';

const items = [
  ...sections.map((s) => ({ group: 'Go to', label: s.label, hint: s.num, action: 'hash', value: `#${s.id}` })),
  ...projects.map((p) => ({ group: 'Projects', label: p.title, hint: p.kind, action: 'hash', value: `#${p.slug}` })),
  { group: 'Actions', label: 'Copy email', hint: person.emailPrimary, action: 'copy', value: person.emailPrimary },
  { group: 'Actions', label: 'Open resume (PDF)', hint: '↗', action: 'open', value: person.resume },
  { group: 'Actions', label: 'GitHub', hint: '↗', action: 'open', value: person.github },
  { group: 'Actions', label: 'LinkedIn', hint: '↗', action: 'open', value: person.linkedin },
  { group: 'Actions', label: 'Toggle light / dark theme', hint: '', action: 'theme', value: '' },
];
---

<dialog id="palette" class="palette" aria-label="Command menu">
  <div class="palette__box">
    <label class="sr-only" for="palette-input">Search commands</label>
    <input id="palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" placeholder="Jump to a section, project or action…" autocomplete="off" spellcheck="false" />
    <ul id="palette-list" role="listbox" aria-label="Results"></ul>
    <p class="palette__empty mono muted" hidden>Nothing matches that. Try "work" or "email".</p>
    <p class="palette__foot mono muted"><span>↑↓ move</span><span>↵ run</span><span>esc close</span></p>
  </div>
  <script type="application/json" id="palette-data" set:html={JSON.stringify(items)} />
</dialog>

<style>
  .palette {
    margin: 12vh auto 0;
    width: min(620px, calc(100% - 2 * var(--gutter)));
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.35);
  }
  .palette::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  input {
    width: 100%;
    padding: var(--space-4) var(--space-5);
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--step-1);
  }
  input:focus-visible {
    outline-offset: -3px;
  }
  ul {
    max-height: 46vh;
    overflow: auto;
    padding: var(--space-2);
  }
  :global(.palette li[role='group']) {
    padding: var(--space-3) var(--space-3) var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
  }
  :global(.palette li[role='option']) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: 4px;
    cursor: pointer;
  }
  :global(.palette li[role='option'] small) {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.palette li[aria-selected='true']) {
    background: var(--ink);
    color: var(--paper);
  }
  :global(.palette li[aria-selected='true'] small) {
    color: inherit;
    opacity: 0.75;
  }
  .palette__empty {
    padding: var(--space-5);
  }
  .palette__foot {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--rule);
  }
</style>
