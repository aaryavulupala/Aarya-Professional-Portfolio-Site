---
import { person, sections } from '../data/content';
---

<header class="header">
  <div class="wrap header__bar">
    <a class="brand" href="#top" aria-label={`${person.name}, ${person.role}: back to top`}>
      <span class="brand__name">{person.name}</span>
      <span class="brand__role mono">{person.role}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`} data-nav={s.id}>{s.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__tools">
      <a class="btn btn--ghost btn--small nav__resume" href={person.resume} target="_blank" rel="noopener">Resume</a>
      <button class="icon-btn kbd" type="button" data-palette-open aria-label="Open command menu" aria-keyshortcuts="Control+K Meta+K">
        <span aria-hidden="true">⌘K</span>
      </button>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch colour theme">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"></path>
        </svg>
      </button>
      <button class="icon-btn menu-btn" type="button" id="menu-open" aria-haspopup="dialog" aria-controls="menu-dialog">Menu</button>
    </div>
  </div>
</header>

<dialog id="menu-dialog" class="sheet" aria-label="Site menu">
  <form method="dialog" class="sheet__head">
    <span class="mono muted">Menu</span>
    <button class="icon-btn" aria-label="Close menu">Close</button>
  </form>
  <ul class="sheet__list">
    {
      sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-close-menu>
            <span class="mono">{s.num}</span>
            {s.label}
          </a>
        </li>
      ))
    }
    <li><a href={person.resume} target="_blank" rel="noopener"><span class="mono">↗</span>Resume (PDF)</a></li>
  </ul>
</dialog>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s;
  }
  :global(.is-scrolled) .header {
    border-bottom-color: var(--rule);
  }
  .header__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.15;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .brand__role {
    color: var(--ink-muted);
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: var(--space-5);
  }
  .nav a {
    font-size: 0.95rem;
    text-decoration: none;
    padding: 6px 0;
    background: linear-gradient(var(--signal), var(--signal)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.25s var(--ease);
  }
  .nav a:hover,
  .nav a[aria-current='true'] {
    background-size: 100% 2px;
  }
  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .nav__resume {
    display: none;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-2);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    transition: border-color 0.2s, color 0.2s;
  }
  .icon-btn:hover {
    border-color: var(--rule);
    color: var(--signal);
  }
  .kbd {
    display: none;
  }
  @media (min-width: 900px) {
    .nav,
    .nav__resume,
    .kbd {
      display: inline-flex;
    }
    .menu-btn {
      display: none;
    }
  }

  .sheet {
    margin: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border: 0;
    padding: var(--gutter);
    background: var(--paper);
    color: var(--ink);
  }
  .sheet::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  .sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-h);
    margin-top: calc(var(--gutter) * -1);
  }
  .sheet__list {
    margin-top: var(--space-6);
  }
  .sheet__list a {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--step-3);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .sheet__list .mono {
    color: var(--signal);
    min-width: 2.2ch;
  }
</style>
