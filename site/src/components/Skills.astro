---
import { skillGroups, tech } from '../data/content';
import Section from './Section.astro';

// AWS is one ball but I use four of its services; say which.
const detail: Record<string, string> = { aws: 'EC2, S3, RDS, Lambda' };
---

<Section id="skills" num="04" label="Skills">
  <p class="section__intro">What I reach for.</p>

  <div class="pit">
    <div class="pit__stage" data-pit>
      <canvas class="pit__canvas" aria-hidden="true"></canvas>
      <div class="pit__tip mono" role="presentation" hidden></div>
      <button class="btn btn--ghost btn--small pit__shake" type="button" hidden>Shake the pit</button>
    </div>
    <p class="pit__hint mono muted" aria-hidden="true">Hover, drag or throw the logos.</p>

    <!-- Source of truth for the canvas, and the accessible / no-JS version -->
    <div class="pit__src">
      {
        skillGroups.map((g) => (
          <section>
            <h3 class="mono">{g.label}</h3>
            <ul class="chips">
              {g.items.map((k) => {
                const t = tech[k];
                const full = 'full' in t && t.full;
                return (
                  <li class="chip" data-logo={`/logos/${t.logo}`} data-name={t.name} data-detail={detail[k] ?? ''} data-full={full ? '1' : ''}>
                    <img class:list={['chip__logo', { 'chip__logo--full': full }]} src={`/logos/${t.logo}`} alt="" width="20" height="20" loading="lazy" />
                    {t.name}
                    {detail[k] ? ` (${detail[k]})` : ''}
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Section>

<script>
  import '../scripts/ballpit';
</script>

<style>
  .pit__stage {
    position: relative;
    height: clamp(320px, 44vw, 460px);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    overflow: hidden;
  }
  .pit__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: default;
  }
  .pit__tip {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -100%);
    padding: 4px 10px;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
    white-space: nowrap;
    pointer-events: none;
  }
  .pit__shake {
    position: absolute;
    right: var(--space-3);
    top: var(--space-3);
    background: var(--paper);
  }
  .pit__hint {
    margin-top: var(--space-3);
  }
  /* with JS the lists are for assistive tech; without it they are the content */
  :global(.js) .pit__src {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  :global(.js) .pit__stage {
    display: block;
  }
  :global(html:not(.js)) .pit__stage,
  :global(html:not(.js)) .pit__hint {
    display: none;
  }
  .pit__src section {
    margin-bottom: var(--space-5);
  }
  .pit__src h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    margin-bottom: var(--space-2);
    color: var(--ink-muted);
  }
</style>
